{
  "name": "fundamentals",
  "version": "0.2.0",
  "description": "SEC EDGAR Financial Fundamentals Dashboard \u2014 React + TypeScript + Tailwind v4 (Parcel)",
  "source": "src/index.html",
  "scripts": {
    "clean": "rimraf -rf dist",
    "ncp": "ncp data dist/data",
    "build-github-pages": "npm run build -- --public-url=/fundamentals/",
    "preserve": "npm run ncp",
    "serve": "npm-run-all --parallel serve:app serve:proxy",
    "serve:app": "parcel --no-cache --no-source-maps",
    "serve:proxy": "npm-run-all --parallel serve:proxy:*",
    "serve:proxy:www": "MODE=www PORT=8011 bun ./scripts/fundamentals-local-proxy.ts",
    "serve:proxy:data": "MODE=data PORT=8012 bun ./scripts/fundamentals-local-proxy.ts",
    "test": "bun test",
    "build": "parcel build --no-cache --no-source-maps",
    "postbuild": "npm run ncp",
    "all:proxy": "bun ./scripts/fundamentals-local-proxy.ts",
    "all:serve": "npm run serve:app",
    "all": "npm-run-all --parallel all:*",
    "start": "pm2 start 'npm run serve' --name fundamentals",
    "restart": "pm2 restart fundamentals",
    "ps": "pm2 ps",
    "logs": "pm2 logs",
    "stop": "pm2 kill",
    "kill": "pm2 kill",
    "data:fetch": "uv run python scripts/fundamentals-data.py",
    "data:fetch:pip": "python scripts/fundamentals-data.py"
  },
  "keywords": [
    "sec",
    "edgar",
    "fundamentals",
    "react",
    "typescript",
    "tailwind",
    "parcel",
    "bun",
    "github-pages"
  ],
  "author": "Maksim Kostromin / GitHub: daggerok",
  "license": "MIT",
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@parcel/resolver-default": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ncp": "2.0.0",
    "npm-run-all": "4.1.5",
    "parcel": "2.16.4",
    "pm2": "7.0.3",
    "rimraf": "6.1.3"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
